<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Cioccolato.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cioccolato.Gui.ViewModels"
        xmlns:strings="using:Cioccolato.Gui.Resources.Strings">

    <Grid Padding="16" RowSpacing="8" ColumnSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="130" />
        </Grid.ColumnDefinitions>

        <!-- New Variety Input -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{x:Bind strings:AppStrings.NewVariety}"
                   FontWeight="Bold" />

        <TextBox Grid.Row="1" Grid.Column="0"
                 x:Name="NewVarietyTextBox"
                 Text="{x:Bind ViewModel.NewVarietyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="{x:Bind strings:AppStrings.EnterVarietyName}"
                 KeyDown="NewVarietyTextBox_KeyDown" />

        <Button Grid.Row="1" Grid.Column="1"
                Content="{x:Bind strings:AppStrings.Add}"
                Command="{x:Bind ViewModel.AddCommand}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center" />

        <!-- Varieties Table -->
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{x:Bind strings:AppStrings.Varieties}"
                   FontWeight="Bold"
                   Margin="0,8,0,0" />

        <Border Grid.Row="3" Grid.Column="0"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8"
                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind strings:AppStrings.Name}"
                               FontWeight="Bold" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind strings:AppStrings.CreatedAt}"
                               FontWeight="Bold" />
                </Grid>

                <ListView Grid.Row="1"
                          x:Name="VarietiesListView"
                          ItemsSource="{x:Bind ViewModel.Varieties}"
                          SelectionMode="Extended"
                          SelectionChanged="VarietiesListView_SelectionChanged"
                          KeyDown="VarietiesListView_KeyDown">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:VarietyItem">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name}"
                                           VerticalAlignment="Center" />
                                <!-- Classic Binding, not x:Bind: WinUI 3 Window is not a FrameworkElement,
                                     so x:Bind's compile-time StaticResource lookup for the converter fails. -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CreatedAt, Converter={StaticResource DateTimeFormatConverter}, ConverterParameter=g}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="8" VerticalAlignment="Top">
            <Button Content="{x:Bind strings:AppStrings.Remove}"
                    Command="{x:Bind ViewModel.RemoveCommand}"
                    HorizontalAlignment="Stretch" />
            <Button Content="{x:Bind strings:AppStrings.RemoveAll}"
                    Command="{x:Bind ViewModel.RemoveAllCommand}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
    </Grid>

</Window>
